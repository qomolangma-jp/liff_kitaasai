              "margin": "sm",
              "contents": [
                { "type": "text", "text": "利用日", "color": "#94a3b8", "size": "xs", "flex": 2, "weight": "bold" },
                { "type": "text", "text": info.date, "color": "#1e293b", "size": "xs", "flex": 5 }
              ]
            },
            {
              "type": "box",
              "layout": "horizontal",
              "margin": "sm",
              "contents": [
                { "type": "text", "text": "時間帯", "color": "#94a3b8", "size": "xs", "flex": 2, "weight": "bold" },
                { "type": "text", "text": info.time_slot, "color": "#1e293b", "size": "xs", "flex": 5 }
              ]
            },
            {
              "type": "box",
              "layout": "horizontal",
              "margin": "sm",
              "contents": [
                { "type": "text", "text": "ご要望", "color": "#94a3b8", "size": "xs", "flex": 2, "weight": "bold" },
                { "type": "text", "text": requestText, "color": "#1e293b", "size": "xs", "flex": 5, "wrap": true }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "box",
      "layout": "horizontal",
      "spacing": "md",
      "contents": [
        {
          "type": "button",
          "style": "primary",
          "color": "#16a34a",
          "height": "sm",
          "action": {
            "type": "postback",
            "label": "承認（確定）",
            // ★ row= の代わりに batchId= を埋め込みます
            "data": "action=approve&batchId=" + info.batchId + "&applicant=" + info.applicantId + "&date=" + info.date + "&room=" + rName + "&slot=" + sName
          }
        },
        {
          "type": "button",
          "style": "secondary",
          "height": "sm",
          "action": {
            "type": "postback",
            "label": "差し戻し（却下）",
            "data": "action=reject&batchId=" + info.batchId + "&applicant=" + info.applicantId + "&date=" + info.date + "&room=" + rName + "&slot=" + sName
          }
        }
      ]
    }
  };

  const payload = {
    "to": admins,
    "messages": [
      {
        "type": "flex",
        "altText": "【北浅井公民館】新規の予約申請があります",
        "contents": flexPayload
      }
    ]
  };

  const options = {
    "method": "post",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer " + LINE_CHANNEL_ACCESS_TOKEN
    },
    "payload": JSON.stringify(payload),
    "muteHttpExceptions": true
  };

  UrlFetchApp.fetch(url, options);
}

// 汎用プッシュメッセージ
function sendLineTextMessage(targetId, text) {
  const url = "https://api.line.me/v2/bot/message/push";
  const payload = {
    "to": targetId,
    "messages": [{ "type": "text", "text": text }]
  };
  const options = {
    "method": "post",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer " + LINE_CHANNEL_ACCESS_TOKEN
    },
    "payload": JSON.stringify(payload),
    "muteHttpExceptions": true
  };
  UrlFetchApp.fetch(url, options);
}

// Webhook応答用
function replyLineMessage(replyToken, text) {
  const url = "https://api.line.me/v2/bot/message/reply";
  const payload = {
    "replyToken": replyToken,
    "messages": [{ "type": "text", "text": text }]
  };
  const options = {
    "method": "post",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer " + LINE_CHANNEL_ACCESS_TOKEN
    },
    "payload": JSON.stringify(payload),
    "muteHttpExceptions": true
  };
  UrlFetchApp.fetch(url, options);
}

function getLineSignatureFromEvent(e) {
  if (!e) return "";

  const candidates = [];

  if (e.headers) {
    candidates.push(e.headers['X-Line-Signature']);
    candidates.push(e.headers['x-line-signature']);
  }

  if (e.parameter) {
    candidates.push(e.parameter['X-Line-Signature']);
    candidates.push(e.parameter['x-line-signature']);
  }

  if (e.parameters) {
    const upper = e.parameters['X-Line-Signature'];
    const lower = e.parameters['x-line-signature'];
    if (upper && upper.length > 0) candidates.push(upper[0]);
    if (lower && lower.length > 0) candidates.push(lower[0]);
  }

  const signature = candidates.find(v => v && v.toString().trim());
  return signature ? signature.toString().trim() : "";
}

function validateSignature(bodyString, signature) {
  // スクリプトプロパティからシークレットを取得
  const secret = getRequiredScriptProperty('LINE_CHANNEL_SECRET');
  const cleanedBody = bodyString.trim();
  
  let computedSignature = "";
  try {
    // GAS側で署名を計算
    const byteSignature = Utilities.computeHmacSignature(
      Utilities.MacAlgorithm.HMAC_SHA_256,
      cleanedBody,
      secret ? secret.trim() : "",
      Utilities.Charset.UTF_8
    );
    computedSignature = Utilities.base64Encode(byteSignature);
  } catch(e) {
    computedSignature = "暗号化計算エラー: " + e.toString();
  }
  
  // 📋 【スプレッドシートへの強制ログ書き出し】
  // 予約台帳のスプレッドシートに「システムログ」というシートを自動作成して書き込みます
  try {
    const ss = SpreadsheetApp.openById(YOYAKU_SS_ID); // グローバル定数のIDを使用
    let logSheet = ss.getSheetByName("システムログ") || ss.insertSheet("システムログ");
    if (logSheet.getLastRow() === 0) {
      logSheet.appendRow(["日時", "LINEからの署名", "GASが計算した署名", "プロパティ取得状態", "一致判定"]);
    }
    
    const secretCheck = secret ? "取得OK (文字数: " + secret.length + ")" : "❌ 取得失敗（空っぽです）";
    const matchCheck = (computedSignature === (signature || "").trim()) ? "⭕ 一致" : "❌ 不一致";
    
    logSheet.appendRow([new Date(), signature, computedSignature, secretCheck, matchCheck]);
  } catch(err) {
    // 万が一スプレッドシートへの書き込み自体が失敗した場合
  }

  // 本来の判定を返す
  if (!signature || !secret) return false;
  return computedSignature === signature.trim();
}

function verifyLiffToken(token) {
  if (!token) return false;

  try {
    const verifyUrl = "https://api.line.me/oauth2/v2.1/verify?access_token=" + encodeURIComponent(token);
    const response = UrlFetchApp.fetch(verifyUrl, {
      method: "get",
      muteHttpExceptions: true
    });

    if (response.getResponseCode() !== 200) return false;

    const result = JSON.parse(response.getContentText() || "{}");
    if (!result.client_id) return false;
    if (result.expires_in !== undefined && Number(result.expires_in) <= 0) return false;

    return true;
  } catch (err) {
    console.error("LIFF token verification error: " + err.toString());
    return false;
  }
}

// ====================================================================
// 🛑【エラー対策】認証を強制的に起動するための使い捨て関数
// ====================================================================
function triggerAuthorization() {
  try {
    UrlFetchApp.getRequest("https://api.line.me/");
  } catch(e) {}
  Logger.log("無事に認証が完了しました！");
}