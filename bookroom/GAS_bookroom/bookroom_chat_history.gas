// ====================================================================
// ⚠️ 設定箇所: ご自身の情報に置き換えてください
// ====================================================================

// 1. LINE公式アカウントの「チャネルアクセストークン」
const LINE_CHANNEL_ACCESS_TOKEN = getRequiredScriptProperty('LINE_CHANNEL_ACCESS_TOKEN');

// ★追加：LINE公式アカウントの「チャネルシークレット」もプロパティ化
const LINE_CHANNEL_SECRET = getRequiredScriptProperty('LINE_CHANNEL_SECRET');

// 2. 予約台帳シートが入っているスプレッドシートのID
const YOYAKU_SS_ID = getRequiredScriptProperty('YOYAKU_SS_ID'); // ※名簿やチャットと同じであればそのままでOK
const YOYAKU_SHEET_NAME = '予約台帳';

// 3. 住民名簿シートが入っているスプレッドシートのID（アップロードされた「LINEto名簿-北浅井」のID）
const MEIBO_SS_ID = getRequiredScriptProperty('MEIBO_SS_ID'); // ※お使いの名簿スプレッドシートIDをここに記述
const MEIBO_SHEET_NAME = '名簿';

// 4. チャットログ（履歴）を保存するスプレッドシートのID
const CHAT_SS_ID = getRequiredScriptProperty('CHAT_SS_ID');
const CHAT_SHEET_NAME = 'chat';

/**
 * 💡 Googleの認証を強制的にパスさせるための特殊アノテーション
 * @OnlyCurrentDoc
 * @filter
 * @OAuthScope https://www.googleapis.com/auth/spreadsheets
 * @OAuthScope https://www.googleapis.com/auth/script.external_request
 */

function getRequiredScriptProperty(key) {
  const value = PropertiesService.getScriptProperties().getProperty(key);
  if (!value) {
    throw new Error('Script property "' + key + '" is not set.');
  }
  return value.trim();
}

// ====================================================================
// 1. GETリクエスト（高速化版：カレンダー、LIFFアプリ用のデータ取得）
// ====================================================================
function doGet(e) {
  // --- 🌟 住民名簿チェック処理 🌟 ---
  if (e && e.parameter && e.parameter.type === "user" && e.parameter.uid) {
    const uid = e.parameter.uid.toString().trim().toLowerCase();
    
    try {
      // getDisplayValues() を使用してすべての値を文字列として高速一括取得
      const mSheet = SpreadsheetApp.openById(MEIBO_SS_ID).getSheetByName(MEIBO_SHEET_NAME);
      const mData = mSheet.getDataRange().getDisplayValues();
      if (mData.length === 0) return createJsonResponse({ isRegistered: false });

      const header = mData[0].map(h => h.trim().toLowerCase());
      
      const idCol = header.indexOf("line_id");
      const lastNameCol = header.indexOf("name_2nd");
      const firstNameCol = header.indexOf("name_1st");
      const statusCol = header.indexOf("status");
      
      if (idCol === -1) {
        return createJsonResponse({ isRegistered: false, error: "line_id column missing" });
      }
      
      // 対象行を検索
      const row = mData.find((r, idx) => idx > 0 && r[idCol] && r[idCol].trim().toLowerCase() === uid);
      
      if (!row) {
        return createJsonResponse({ isRegistered: false });
      }
      
      const lastName = lastNameCol !== -1 ? row[lastNameCol] : "";
      const firstName = firstNameCol !== -1 ? row[firstNameCol] : "";
      const fullName = (lastName + " " + firstName).trim();
      const status = (statusCol !== -1 && row[statusCol]) ? row[statusCol].trim().toUpperCase() : "OK";
      
      return createJsonResponse({
        isRegistered: true,
        fullName: fullName,
        status: status
      });
      
    } catch(err) {
      console.error("名簿判定エラー: " + err.toString());
      return createJsonResponse({ isRegistered: true, fullName: "通信エラー", status: "OK" });
    }
  }
  
  // --- 📅 予約一覧を取得する処理 (高速化) ---
  try {
    const sheet = SpreadsheetApp.openById(YOYAKU_SS_ID).getSheetByName(YOYAKU_SHEET_NAME);
    // getDisplayValues() を使用：日付のUtilities.formatDate計算コストを排除
    const displayData = sheet.getDataRange().getDisplayValues();
    
    const reservations = [];
    for (let i = 1; i < displayData.length; i++) {
      const row = displayData[i];
      const status = row[7]; // H列
      
      if (status === "確定" || status === "保留") { 
        reservations.push({
          date: row[3],      // D列（スプレッドシート上の表示文字列「yyyy-MM-dd」をそのまま使用）
          time_slot: row[4], // E列
          room: row[5],      // F列
          line_id: row[1],   // B列
          name: row[2],      // C列
          status: status
        });
      }
    }
    return createJsonResponse(reservations);

  } catch(err) {
    console.error("予約一覧取得エラー: " + err.toString());
    return createJsonResponse([]);
  }
}

// レスポンス作成用の軽量ヘルパー関数
function createJsonResponse(data) {
  return ContentService.createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}


// ====================================================================
// 2. POSTリクエスト（LIFFからの新規予約、およびLINE Webhookの分岐処理）
// ====================================================================
function doPost(e) {
  try {
    const bodyString = e && e.postData && e.postData.contents ? e.postData.contents : "{}";
    const postData = JSON.parse(bodyString);

    // A. LINEからのWebhookシグナルの場合（メッセージ受信、ポストバックボタン等）
    if (postData.events) {
      
      // LINE Developersからの「検証」ボタン用バイパス
      if (postData.events.length === 0) {
        return ContentService.createTextOutput(JSON.stringify({ result: "ok" }))
                             .setMimeType(ContentService.MimeType.JSON);
      }
      
      // 🔒 【セキュリティ】URLパラメータから秘密の合言葉を検証
      const systemSecret = getRequiredScriptProperty('WEBHOOK_SECRET');
      const incomingSecret = e && e.parameter ? e.parameter.secret : null;
      
      const isSecretValid = (systemSecret && incomingSecret === systemSecret);
      const matchCheck = isSecretValid ? "⭕ 一致" : "❌ 不一致";
      const secretCheck = systemSecret ? "設定あり (文字数: " + systemSecret.length + ")" : "❌ 未設定";

      // 📋 【ご要望：システムログシートへの詳細な状況書き出し】
      try {
        const ss = SpreadsheetApp.openById(YOYAKU_SS_ID); // グローバル定数の予約台帳IDを使用
        let logSheet = ss.getSheetByName("システムログ") || ss.insertSheet("システムログ");
        
        // シートが新しく作られた、または空の場合はヘッダーをリセット
        if (logSheet.getLastRow() === 0 || logSheet.getRange("B1").getValue() === "LINEからの署名") {
          logSheet.clear();
          logSheet.appendRow(["日時", "LINEから届いた合言葉(URL)", "GAS側の設定状態", "プロパティ状態", "合言葉の一致判定"]);
        }
        
        logSheet.appendRow([
          new Date(), 
          incomingSecret || "（空っぽ・URLの末尾に付いていません）", 
          systemSecret ? "⭕ 稼働中" : "❌ 未設定", 
          secretCheck, 
          matchCheck
        ]);
      } catch(err) {
        console.error("システムログへの書き込みに失敗しました: " + err.toString());
      }
      
      // 🔒 合言葉の検証に失敗した場合はここで処理をブロック
      if (!isSecretValid) {
        console.warn("⚠️ 不正なWebhookアクセス（Secret不一致）をブロックしました。");
        return ContentService.createTextOutput(JSON.stringify({ result: "unauthorized" }))
                             .setMimeType(ContentService.MimeType.JSON);
      }
      
      // 🟢 合言葉が一致した場合のみ、本来の処理（承認・却下など）を実行
      return handleLineWebhook(postData.events);
      
    } else {
      // B. 住民用のLIFF予約フォームから直接送られてきた新規申請
      if (!verifyLiffToken(postData.liff_token)) {
        return ContentService.createTextOutput(JSON.stringify({ status: "error", message: "invalid liff token" }))
                             .setMimeType(ContentService.MimeType.JSON);
      }
      return handleLiffSubmission(postData);
    }

  } catch(error) {
    console.error("❌ doPost内でエラーが発生しました: " + error.toString());
    return ContentService.createTextOutput(JSON.stringify({ status: "error", message: error.toString() }))
                         .setMimeType(ContentService.MimeType.JSON);
  }
}


// --------------------------------------------------------------------
// A-1. LINE Webhookのイベントをスマートに仕分ける
// --------------------------------------------------------------------
function handleLineWebhook(events) {
  const chatRows = [];

  events.forEach(event => {
    // 【仕分け1】一般のテキストメッセージ受信 ➔ チャット履歴に保存
    if (event.type === 'message' && event.message.type === 'text') {
      const userId = event.source.userId;
      const messageText = event.message.text;
      const timestamp = new Date(event.timestamp);
      
      // 名簿またはLINE Profile APIから本名・表示名を取得
      const memberInfo = getMemberInfoWithCache(userId);
      const displayName = memberInfo && memberInfo.fullName ? memberInfo.fullName : getLineDisplayName(userId);

      chatRows.push([
        Utilities.formatDate(timestamp, "JST", "yyyy/MM/dd HH:mm:ss"), // 日本時間
        displayName,
        messageText,
        userId
      ]);
    }
    
    // 【仕分け2】管理者のFlex Message内「承認」「差し戻し」ボタンタップ処理
    if (event.type === "postback") {
      processPostbackApproval(event);
    }
  });

  // チャットログがあれば「chat」シートにまとめて書き込む
  if (chatRows.length > 0) {
    const ss = SpreadsheetApp.openById(CHAT_SS_ID);
    const sheet = ss.getSheetByName(CHAT_SHEET_NAME) || ss.insertSheet(CHAT_SHEET_NAME);
    
    if (sheet.getLastRow() < 1 || sheet.getRange('A1').getValue() !== 'created_at') {
      sheet.clear();
      sheet.appendRow(['created_at', 'line_name', 'message', 'line_id']);
    }
    sheet.getRange(sheet.getLastRow() + 1, 1, chatRows.length, chatRows[0].length).setValues(chatRows);
  }

  return ContentService.createTextOutput('{"result": "ok"}').setMimeType(ContentService.MimeType.JSON);
}

// --------------------------------------------------------------------
// A-2. 管理者の承認ポストバック処理（一括承認対応）
// --------------------------------------------------------------------
function processPostbackApproval(event) {
  const replyToken = event.replyToken;
  
  // ポストバックデータのパース
  const params = {};
  event.postback.data.split("&").forEach(pair => {
    const parts = pair.split("=");
    params[parts[0]] = decodeURIComponent(parts[1]);
  });
  
  const sheet = SpreadsheetApp.openById(YOYAKU_SS_ID).getSheetByName(YOYAKU_SHEET_NAME);
  const data = sheet.getDataRange().getValues();
  const targetBatchId = params.batchId;
  
  // 対象 batchId の行をすべて検索
  const targetRowIndices = [];
  let isAlreadyProcessed = false;

  for (let i = 1; i < data.length; i++) {
    // I列 (インデックス 8) が batchId
    if (data[i][8] === targetBatchId) {
      targetRowIndices.push(i + 1); // シート上の行番号 (1-indexed)
      // すでに「確定」または「却下」になっているか確認
      if (data[i][7] !== "保留") {
        isAlreadyProcessed = true;
      }
    }
  }

  if (targetRowIndices.length === 0) {
    replyLineMessage(replyToken, "⚠️ 対象の予約データが見つかりませんでした。");
    return;
  }

  if (isAlreadyProcessed) {
    replyLineMessage(replyToken, "⚠️ この予約申請はすでに処理済みです。");
    return;
  }
  
  const applicantId = params.applicant;
  const reqDate = params.date;
  const reqRoom = params.room;
  const reqSlot = params.slot;

  if (params.action === "approve") {
    // 該当する行をすべて「確定」に一括変更
    targetRowIndices.forEach(rowNum => {
      sheet.getRange(rowNum, 8).setValue("確定");
    });
    
    const successMsg = "🎉【北浅井公民館】予約確定のお知らせ\n\nご申請いただいておりました公民館の予約が、管理者により【承認】されました！\n当日のお越しをお待ちしております。\n\n" +
                       "■施設: " + reqRoom + "\n" +
                       "■日付: " + reqDate + "\n" +
                       "■時間帯: " + reqSlot;
    sendLineTextMessage(applicantId, successMsg);
    replyLineMessage(replyToken, "✅ 予約申請を【一括承認】しました。申請者に確定通知を送信しました。");

  } else if (params.action === "reject") {
    // 該当する行をすべて「却下」に一括変更
    targetRowIndices.forEach(rowNum => {
      sheet.getRange(rowNum, 8).setValue("却下");
    });
    
    const failMsg = "⚠️【北浅井公民館】予約差し戻しのお知らせ\n\nご申請いただいておりました公民館の予約は、スケジュール重複等の理由により【却下】となりました。\n大変恐縮ですが、別の日程または施設をご検討ください。\n\n" +
                    "■施設: " + reqRoom + "\n" +
                    "■日付: " + reqDate + "\n" +
                    "■時間帯: " + reqSlot;
    sendLineTextMessage(applicantId, failMsg);
    replyLineMessage(replyToken, "❌ 予約申請を【一括却下（差し戻し）】しました。申請者に通知を送信しました。");
  }
}

// --------------------------------------------------------------------
// B. LIFFからの新規予約申請処理（スプレッドシートへ「保留」として追記）
// --------------------------------------------------------------------
// --------------------------------------------------------------------
// B. LIFFからの新規予約申請処理（スプレッドシートへ「保留」として追記）
// --------------------------------------------------------------------
function handleLiffSubmission(params) {
  const sheet = SpreadsheetApp.openById(YOYAKU_SS_ID).getSheetByName(YOYAKU_SHEET_NAME);
  const data = sheet.getDataRange().getValues();
  
  // フロントから time_slots（配列）または time_slot（単体文字列）のどちらが来ても対応
  const targetSlots = params.time_slots 
    ? params.time_slots 
    : (params.time_slot === "終日" ? ["午前", "午後", "夜間"] : [params.time_slot]);

  // 重複チェック（対象のスロットが1つでも埋まっていればエラー）
  for (let i = 1; i < data.length; i++) {
    const rowDate = Utilities.formatDate(new Date(data[i][3]), "JST", "yyyy-MM-dd");
    const status = data[i][7];
    if (rowDate === params.date && data[i][5] === params.room && (status === "確定" || status === "保留")) {
      if (targetSlots.includes(data[i][4])) {
        return ContentService.createTextOutput(JSON.stringify({ 
          status: "error", 
          message: "すでに一部の時間帯で予約または申請が入っています。" 
        })).setMimeType(ContentService.MimeType.JSON);
      }
    }
  }
  
  const memberInfo = getMemberInfoWithCache(params.line_id);
  let realName = memberInfo && memberInfo.fullName ? memberInfo.fullName : params.line_name;
  const requestText = (params.request || "").toString().trim() || "なし";
  
  // ★ 1回の申請を一括管理するためのユニークIDを発行
  const batchId = "BATCH_" + new Date().getTime();
  const now = new Date();

  // 対象となる全スロット（終日の場合は午前・午後・夜間の3行）を追記
  targetSlots.forEach(slot => {
    sheet.appendRow([
      now,                // A列: 申請日時
      params.line_id,     // B列: LINE ID
      realName,           // C列: 氏名
      params.date,        // D列: 日付
      slot,               // E列: 時間帯
      params.room,        // F列: 部屋
      requestText,        // G列: 要望
      "保留",             // H列: ステータス
      batchId             // ★ I列: 一括識別ID (batch_id)
    ]);
  });

  const displaySlotText = targetSlots.length === 3 ? "終日 (午前・午後・夜間)" : targetSlots.join(", ");

  // 1. 申請者本人へ受付完了プッシュメッセージ送信
  const userMsg = "【北浅井公民館】\n予約の申請を受け付けました。\n現在、管理者による確認を行っております。確定するまで今しばらくお待ちください。\n\n" +
                  "■施設: " + params.room + "\n" +
                  "■日付: " + params.date + "\n" +
                  "■時間帯: " + displaySlotText + "\n" +
                  "■ご要望: " + requestText + "\n\n" +
                  "※審査結果は本チャットにて自動でお知らせします。";
  sendLineTextMessage(params.line_id, userMsg);

  // 2. 管理者へFlex承認ボタン付き通知を送信（batchId を引き渡す）
  const admins = getAdmins();
  if (admins.length > 0) {
    sendAdminFlexApproval(admins, {
      batchId: batchId,
      applicantId: params.line_id,
      applicantName: realName,
      date: params.date,
      room: params.room,
      time_slot: displaySlotText,
      request: requestText
    });
  }

  return ContentService.createTextOutput(JSON.stringify({ status: "success" }))
    .setMimeType(ContentService.MimeType.JSON);
}

// ====================================================================
// 共通のデータ処理・LINE通信用ヘルパー関数群
// ====================================================================

// 住民名簿シートから本名（姓 名）を取得する
function getMemberInfo(uid) {
  if (!uid) return null;
  try {
    const meiboSS = SpreadsheetApp.openById(MEIBO_SS_ID);
    const mSheet = getMeiboSheet();
    const mData = mSheet.getDataRange().getValues();
    const header = mData[0];
    
    const idCol = header.indexOf("line_id");
    const lastNameCol = header.indexOf("name_2nd");
    const firstNameCol = header.indexOf("name_1st");

    const row = mData.find(r => r[idCol] === uid);
    if (!row) return null;

    return {
      fullName: row[lastNameCol] + " " + row[firstNameCol]
    };
  } catch (e) {
    return null;
  }
}

function getMemberInfoWithCache(uid) {
  const cache = CacheService.getScriptCache();
  const cached = cache.get("user_" + uid);
  if (cached) {
    return JSON.parse(cached); // キャッシュがあればシートを見に行かない！
  }

  // キャッシュがない場合のみシートから取得
  const info = getMemberInfo(uid); 
  if (info) {
    cache.put("user_" + uid, JSON.stringify(info), 600); // 10分間保存
  }
  return info;
}

// ⭕ 改善後: キャッシュ（グローバル保持）またはまとめて1回取得
let _meiboSheetCache = null;
function getMeiboSheet() {
  if (!_meiboSheetCache) {
    _meiboSheetCache = SpreadsheetApp.openById(MEIBO_SS_ID).getSheetByName(MEIBO_SHEET_NAME);
  }
  return _meiboSheetCache;
}


// アラート管理者の line_id リストを取得する
function getAdmins() {
  try {
    const meiboSS = SpreadsheetApp.openById(MEIBO_SS_ID);
    const mSheet = meiboSS.getSheetByName(MEIBO_SHEET_NAME);
    const mData = mSheet.getDataRange().getValues();
    const header = mData[0];
    
    const idCol = header.indexOf("line_id");
    const alertCol = header.indexOf("alert");
    
    const admins = [];
    for (let i = 1; i < mData.length; i++) {
      const row = mData[i];
      if (row[alertCol] && row[idCol]) {
        const alertList = row[alertCol].toString().split(",").map(item => item.trim());
        if (alertList.includes("bookroom")) {
          admins.push(row[idCol].toString());
        }
      }
    }
    return admins;
  } catch(e) {
    console.error("管理者取得エラー: " + e.toString());
    return [];
  }
}

// LINE Profile APIから表示名を取得
function getLineDisplayName(userId) {
  const profileUrl = `https://api.line.me/v2/bot/profile/${userId}`;
  const options = {
    'method': 'get',
    'headers': {
      'Authorization': `Bearer ${LINE_CHANNEL_ACCESS_TOKEN}`
    },
    'muteHttpExceptions': true
  };
  try {
    const response = UrlFetchApp.fetch(profileUrl, options);
    const profile = JSON.parse(response.getContentText());
    if (profile && profile.displayName) {
      return profile.displayName;
    }
  } catch (e) {
    Logger.log(`Failed to fetch profile: ${e.toString()}`);
  }
  return `ID:${userId}`; 
}

